{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://schemas.erutech.example/eru-page.schema.json",
    "title": "EruPage",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "id",
        "name",
        "components",
        "styles"
    ],
    "properties": {
        "id": {
            "type": "string"
        },
        "name": {
            "type": "string"
        },
        "title": {
            "type": "string"
        },
        "entity_name": {
            "type": "string"
        },
        "route": {
            "type": "string"
        },
        "components": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/EruComponent"
            }
        },
        "styles": {
            "$ref": "#/$defs/PageStyles"
        },
        "display_mode": {
            "type": "string",
            "enum": [
                "inline",
                "popup",
                "side_panel"
            ]
        },
        "parent_page_id": {
            "type": "string"
        },
        "state": {
            "type": "array",
            "description": "Reactive page-level state variables, referenced from components via @state.<key>.",
            "items": {
                "$ref": "#/$defs/PageStateVariable"
            }
        },
        "events": {
            "type": "array",
            "description": "Page-level event subscriptions (e.g. on_load fired after nested data arrives).",
            "items": {
                "$ref": "#/$defs/ComponentEventSubscription"
            }
        },
        "master_detail_config": {
            "$ref": "#/$defs/MasterDetailConfig"
        }
    },
    "$defs": {
        "PageStateVariable": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "key",
                "initial"
            ],
            "properties": {
                "key": {
                    "type": "string",
                    "description": "Identifier used to reference the state variable, e.g. @state.<key>."
                },
                "initial": {
                    "description": "Initial value (string|number|boolean|null|array|object)."
                },
                "formula": {
                    "$ref": "#/$defs/StateFormula"
                }
            }
        },
        "StateFormula": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "fn"
            ],
            "properties": {
                "fn": {
                    "type": "string",
                    "enum": [
                        "count",
                        "sum",
                        "avg",
                        "min",
                        "max",
                        "expr"
                    ]
                },
                "source": {
                    "type": "string",
                    "enum": [
                        "pageDataArray"
                    ]
                },
                "field": {
                    "type": "string"
                },
                "filter": {
                    "oneOf": [
                        {
                            "$ref": "#/$defs/StateFilter"
                        },
                        {
                            "type": "array",
                            "items": {
                                "$ref": "#/$defs/StateFilter"
                            }
                        }
                    ]
                },
                "value": {
                    "type": "string"
                }
            }
        },
        "StateFilter": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "field"
            ],
            "properties": {
                "field": {
                    "type": "string"
                },
                "equals": {},
                "not_empty": {
                    "type": "boolean"
                },
                "in": {
                    "type": "array"
                },
                "not_in": {
                    "type": "array"
                }
            }
        },
        "UpdateStateFormula": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "fn"
            ],
            "properties": {
                "fn": {
                    "type": "string",
                    "enum": [
                        "set",
                        "increment",
                        "decrement",
                        "toggle",
                        "set-from-field",
                        "set-from-payload",
                        "reset",
                        "expr"
                    ]
                },
                "value": {},
                "by": {
                    "type": "number"
                },
                "values": {
                    "type": "array"
                },
                "field": {
                    "type": "string"
                },
                "expr": {
                    "type": "string"
                },
                "payload_path": {
                    "type": "string"
                }
            }
        },
        "MasterDetailConfig": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "master_field",
                "detail_field",
                "relationship_type"
            ],
            "properties": {
                "master_field": {
                    "type": "string"
                },
                "detail_field": {
                    "type": "string"
                },
                "relationship_type": {
                    "type": "string",
                    "enum": [
                        "one-to-many",
                        "many-to-one",
                        "one-to-one"
                    ]
                },
                "auto_open": {
                    "type": "boolean"
                },
                "display_mode": {
                    "type": "string",
                    "enum": [
                        "popup",
                        "side_panel"
                    ]
                }
            }
        },
        "EruComponent": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "type",
                "properties",
                "styles"
            ],
            "properties": {
                "id": {
                    "type": "string"
                },
                "type": {
                    "type": "string"
                },
                "isNested": {
                    "type": "boolean"
                },
                "nesting_type": {
                    "type": "string",
                    "enum": [
                        "none",
                        "object",
                        "array",
                        "nested_object",
                        "nested_array"
                    ]
                },
                "pageId": {
                    "type": "string"
                },
                "index": {
                    "type": "integer"
                },
                "entityName": {
                    "type": "string"
                },
                "properties": {
                    "$ref": "#/$defs/ResponsiveEruComponentProperties"
                },
                "styles": {
                    "$ref": "#/$defs/ComponentStyles"
                },
                "events": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/ComponentEventSubscription"
                    }
                },
                "validation_rules": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/ValidationRule"
                    }
                },
                "children": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/EruComponent"
                    }
                },
                "parent_id": {
                    "type": "string"
                },
                "created_at": {
                    "type": "string",
                    "description": "Timestamp string (format not enforced; you may choose to enforce date-time in your implementation)."
                },
                "updated_at": {
                    "type": "string",
                    "description": "Timestamp string (format not enforced; you may choose to enforce date-time in your implementation)."
                }
            }
        },
        "PageStyles": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "classes",
                "responsive_classes",
                "responsive_styles",
                "custom"
            ],
            "properties": {
                "classes": {
                    "type": "string"
                },
                "responsive_classes": {
                    "$ref": "#/$defs/ResponsiveClasses"
                },
                "responsive_styles": {
                    "$ref": "#/$defs/ResponsiveStyleProperties"
                },
                "custom": {
                    "type": "object",
                    "additionalProperties": true
                }
            }
        },
        "ComponentStyles": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "classes",
                "responsive_classes",
                "responsive_styles",
                "custom"
            ],
            "properties": {
                "classes": {
                    "type": "string"
                },
                "responsive_classes": {
                    "$ref": "#/$defs/ResponsiveClasses"
                },
                "responsive_styles": {
                    "$ref": "#/$defs/ResponsiveStyleProperties"
                },
                "custom": {
                    "type": "object",
                    "additionalProperties": true
                }
            }
        },
        "ResponsiveClasses": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "base": {
                    "type": "string"
                },
                "sm": {
                    "type": "string"
                },
                "md": {
                    "type": "string"
                },
                "lg": {
                    "type": "string"
                },
                "xl": {
                    "type": "string"
                },
                "2xl": {
                    "type": "string"
                }
            }
        },
        "ResponsiveStyleProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "base": {
                    "$ref": "#/$defs/StyleProperties"
                },
                "sm": {
                    "$ref": "#/$defs/StyleProperties"
                },
                "md": {
                    "$ref": "#/$defs/StyleProperties"
                },
                "lg": {
                    "$ref": "#/$defs/StyleProperties"
                },
                "xl": {
                    "$ref": "#/$defs/StyleProperties"
                },
                "2xl": {
                    "$ref": "#/$defs/StyleProperties"
                }
            }
        },
        "ResponsiveEruComponentProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "base": {
                    "$ref": "#/$defs/EruComponentProperties"
                },
                "sm": {
                    "$ref": "#/$defs/EruComponentProperties"
                },
                "md": {
                    "$ref": "#/$defs/EruComponentProperties"
                },
                "lg": {
                    "$ref": "#/$defs/EruComponentProperties"
                },
                "xl": {
                    "$ref": "#/$defs/EruComponentProperties"
                },
                "2xl": {
                    "$ref": "#/$defs/EruComponentProperties"
                }
            }
        },
        "EruComponentProperties": {
            "type": "object",
            "description": "Component properties; supports known fields plus arbitrary component-specific keys.",
            "properties": {
                "name": {
                    "type": "string"
                },
                "placeholder": {
                    "type": "string"
                },
                "label": {
                    "type": "string"
                },
                "alt": {
                    "type": "string"
                },
                "href": {
                    "type": "string"
                },
                "target": {
                    "type": "string"
                },
                "disabled": {
                    "type": "boolean"
                },
                "required": {
                    "type": "boolean"
                },
                "readonly": {
                    "type": "boolean"
                },
                "options": {
                    "type": "array",
                    "items": {}
                },
                "identifier": {
                    "type": "boolean"
                }
            },
            "additionalProperties": true
        },
        "StyleProperties": {
            "type": "object",
            "description": "Arbitrary CSS-like style map (keys and value types may vary).",
            "additionalProperties": {
                "anyOf": [
                    {
                        "type": "string"
                    },
                    {
                        "type": "number"
                    },
                    {
                        "type": "boolean"
                    },
                    {
                        "type": "null"
                    },
                    {
                        "type": "array"
                    },
                    {
                        "type": "object"
                    }
                ]
            }
        },
        "ComponentEventSubscription": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "event",
                "action"
            ],
            "properties": {
                "id": {
                    "type": "string"
                },
                "event": {
                    "type": "string"
                },
                "action": {
                    "type": "string",
                    "enum": [
                        "no-action",
                        "call-api",
                        "fetch-page-data",
                        "save-page-data",
                        "clear-page-data",
                        "clear-all-page-data",
                        "hide-fields",
                        "unhide-fields",
                        "disable-field",
                        "enable-field",
                        "set-field",
                        "hide-component",
                        "show-component",
                        "disable-component",
                        "enable-component",
                        "start-loading",
                        "stop-loading",
                        "start-timer",
                        "stop-timer",
                        "refresh-grid",
                        "update-state",
                        "step-forward",
                        "step-back",
                        "emit-to-parent",
                        "toggle-side-panel",
                        "open-side-panel",
                        "close-side-panel",
                        "navigate-to-page"
                    ]
                },
                "apiName": {
                    "type": "string"
                },
                "fieldNames": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "page_id": {
                    "type": "string"
                },
                "payload": {},
                "state_key": {
                    "type": "string"
                },
                "state_formula": {
                    "$ref": "#/$defs/UpdateStateFormula"
                },
                "value": {},
                "on_success": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/ComponentEventSubscription"
                    }
                },
                "on_error": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/ComponentEventSubscription"
                    }
                },
                "error_field": {
                    "type": "string"
                },
                "error_state_key": {
                    "type": "string"
                },
                "validate_before_action": {
                    "type": "boolean"
                },
                "validate_field_names": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "action": {
                                "const": "call-api"
                            }
                        },
                        "required": [
                            "action"
                        ]
                    },
                    "then": {
                        "required": [
                            "apiName"
                        ]
                    }
                }
            ]
        },
        "ValidationRule": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "type",
                "message"
            ],
            "properties": {
                "type": {
                    "type": "string",
                    "enum": [
                        "required",
                        "min",
                        "max",
                        "minLength",
                        "maxLength",
                        "pattern",
                        "email",
                        "custom"
                    ]
                },
                "value": {},
                "message": {
                    "type": "string"
                }
            }
        }
    }
}